{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build frontend",
      "type": "npm",
      "script": "build",
      "path": "frontend",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Publish backend",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "-c",
        "Release",
        "-o",
        "./publish"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend/src/PlanSekvenci.Api"
      },
      "group": "build",
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
